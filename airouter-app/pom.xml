<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.airouter</groupId>
    <artifactId>airouter</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>airouter-app</artifactId>

  <name>AiRouter :: app</name>
  <description>启动与装配。跨模块的结构约束也住在这里：只有它看得到全部四个模块。</description>

  <dependencies>
    <dependency>
      <groupId>io.github.airouter</groupId>
      <artifactId>airouter-gateway</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.airouter</groupId>
      <artifactId>airouter-agent</artifactId>
    </dependency>

    <!-- WebFlux 而不是 Servlet：网关两头的流量都是长连接 + 流式，
         阻塞式 IO 模型在这里会把一条流的成本压在一个线程上（ADR-0002 第 2 节）。
         它同时是后续所有端到端测试的入站接缝 —— 整个项目只允许有这一个。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webflux</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- 厂商自己的客户端。它只在测试里出现，作用是把「标准客户端能否直接解析我们的响应」
         这件事交给第三方判定：自己写断言证明自己合规，等于自己批自己的卷子。 -->
    <dependency>
      <groupId>com.openai</groupId>
      <artifactId>openai-java</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- 这里刻意**不**声明 test 作用域的 spring-web。
         它已经由 webflux starter 以 compile 作用域传递进来，而在这里再声明一次并标成 test，
         会按「最近声明优先」把整个 spring-web 降到 test —— 于是可执行 jar 里没有它，
         启动期在 WebClient.builder() 上抛 NoClassDefFoundError。
         测试要用的 HTTP 状态码类型（R4 的违规样例）跟着 compile 作用域一起就在测试 classpath 上。 -->
  </dependencies>

  <build>
    <plugins>
      <!-- 打出可执行 jar：目的是让「可执行 jar 能不能起得来」这件事可以用一条命令回答，
           而不是先祈祷 IDE 的 run configuration 和它一致（阶段 2 起 @SpringBootApplication 已存在）。 -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>repackage</id>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
