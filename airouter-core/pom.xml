<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.airouter</groupId>
    <artifactId>airouter</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>airouter-core</artifactId>

  <name>AiRouter :: core</name>
  <description>领域模型与端口。这里出现任何框架都是设计倒退（ADR-0003 第 1 节）。</description>

  <dependencies>
    <!-- 测试依赖刻意不是 spring-boot-starter-test：那会把 Spring 带进依赖树，而 R1 判红的
         是**依赖树**，不看作用域。领域模型不需要容器，它的测试也不需要。 -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>


  <build>
    <plugins>
      <!-- R1 —— 保护「core 是被边界保护着的，而不是靠自觉」（spec 故事 14）。
           依赖树里出现 Spring / Jackson / Reactor 即失败，且查传递依赖：
           一个框架哪怕是别人顺手带进来的，也算污染。 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>core-stays-framework-free</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <message>
                    airouter-core 的依赖树里出现了框架。core 是离框架最远的模块：
                    领域模型要能在没有任何容器的情况下被单测（ADR-0003 第 1 节）。
                    需要的能力请抽成端口放在 core，实现放到 gateway。
                  </message>
                  <searchTransitive>true</searchTransitive>
                  <excludes>
                    <exclude>org.springframework*</exclude>
                    <!-- Jackson 2 与 Jackson 3 都要写：Boot 4 已经把 databind 的坐标换到
                         tools.jackson 之下，只写 com.fasterxml.jackson* 会让 R1 在这里失效，
                         而它失效的方式是静默的 —— 什么都不报。 -->
                    <exclude>com.fasterxml.jackson*</exclude>
                    <exclude>tools.jackson*</exclude>
                    <exclude>io.projectreactor*</exclude>
                  </excludes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
