# 变量名与 EndpointProperties / StreamProperties 里的常量同名 —— 改名的唯一合法入口是那两个类。
# 本文件只是名字清单，不含任何真实值。复制它到 .env 之前先确认 .env 已被 .gitignore 忽略
# （.gitignore 里 .env 与 .env.* 都被忽略，只有 .env.example 例外）。

# 端点说哪一种话：本阶段只有 openai（OpenAI 兼容，地址以 /v1 结尾，需要凭证）。
# 形态必须由配置显式给出，不能由地址猜 —— 同一台本机 Ollama 上 /v1 与 /api 两种地址都在。
AIROUTER_ENDPOINT_SHAPE=openai

# 形态 openai 要求这个地址以 /v1 结尾且不带尾斜杠。少了后缀不会在启动期报错，
# 只会变成一次深入运行期的 404 —— 所以它是启动期校验，不是约定。
AIROUTER_ENDPOINT_BASE_URL=https://api.example.com/v1

# 真实的密钥只存在于环境里，不进任何受跟踪文件。
AIROUTER_ENDPOINT_API_KEY=

# 一个具体可用模型名，例如 deepseek-chat / qwen-plus。
AIROUTER_ENDPOINT_MODEL=

# 单次调用的总上限，例如 30s / 2m。有默认值（30s），但它是 Endpoint 的一个属性，
# 显式给出来才知道「一条请求最多占多久」。
AIROUTER_ENDPOINT_TIMEOUT=30s

# 流式路径上两帧之间的最大静默时长（默认 15s）。它不是总时长：
# 一条流可以持续很久，只要上游一直在说话。设成总时长等于替调用方决定「模型最多想多久」。
AIROUTER_STREAM_IDLE_TIMEOUT=15s

# 单条流累积内容的字符上限，超出之后截断展示（用量仍取上游回报，默认 262144）。
AIROUTER_STREAM_MAX_CONTENT_CHARS=262144

# 单帧上限：一个换行之前最多允许多少字节（默认 1048576）。一个永远不发换行的上游
# 会让缓存无限增长，而这个上限是唯一能在解码之前拦住它的东西。
AIROUTER_STREAM_MAX_FRAME_BYTES=1048576

# 入站缓冲区：客户端请求体最多允许多少字节进内存（默认 262144）。
AIROUTER_STREAM_INBOUND_BUFFER_BYTES=262144

# 出站缓冲区：一次非流式响应最多允许多少字节进内存（默认 1048576）。流式不聚合，不受它约束。
AIROUTER_STREAM_OUTBOUND_BUFFER_BYTES=1048576

# 档位切换的唯一开关：local（本机 Ollama，不需要网络，端点那四个值都可以不设）
# / cloud（上面的真实端点）。本机端点的安装与实测能力边界见 docs/runbook/local-openai-endpoint.md。
SPRING_PROFILES_ACTIVE=cloud
