# 变量名清单。变量的名字与 EndpointProperties / StreamProperties 里的常量同名 ——
# 改名的唯一合法入口是那两个类，不是这里。
#
# 本文件只是名字清单，不含任何真实值；复制它到 .env 之前先确认 .env 已被 .gitignore 忽略。
# 清单只列**当前这一版真的会读**的变量：形态与档位那几个随票 06 补回来，
# 治理阈值随阶段 7 补回来 —— 列一个还不存在的变量，等于承诺一件还没有的东西。

# 端点根地址。OpenAI 兼容端点以 /v1 结尾：
# 少了它不会在启动期报错，只会变成一次深入运行期的 404
# （地址形态的启动期校验随形态一起进来，票 06）。
AIROUTER_ENDPOINT_BASE_URL=https://api.example.com/v1

# 端点密钥。真实的密钥只存在于环境里，不进任何受跟踪文件。
AIROUTER_ENDPOINT_API_KEY=

# 默认模型名：客户端没指定模型时用它。
AIROUTER_ENDPOINT_MODEL=

# 单次调用的总上限，例如 30s / 2m。有默认值（30s），但它是 Endpoint 的一个属性，
# 显式给出来才知道「一条请求最多占多久」。
AIROUTER_ENDPOINT_TIMEOUT=30s

# 流式 SLO 三角（三条腿，缺一条流式就是「看起来能用、出事时说不清」）。
# 五个值都有兜底数字，但它们是显式的 SLO 而不是调参：改它们就是在改
# 「一条失控的流最多能吃掉多少」。非正数会在启动期判红。

# 块间静默上限。**不是总时长**：一条想很久但一直在说话的流不会被误杀，
# 一条收了连接就不再出声的流会在这么久之后被判超时。
AIROUTER_STREAM_IDLE_TIMEOUT=15s

# 单条流累积内容的字符上限。超出之后不再往下发内容，但流继续走到终态 ——
# 截断只影响展示，用量仍取上游回报。
AIROUTER_STREAM_MAX_CONTENT_CHARS=262144

# 单帧上限：一个换行之前最多允许多少字节。
# 它是唯一能在解码之前拦住「一个不发换行的上游」的东西。
AIROUTER_STREAM_MAX_FRAME_BYTES=1048576

# 入站缓冲区：客户端请求体最多允许多少字节进内存。
AIROUTER_STREAM_INBOUND_BUFFER_BYTES=262144

# 出站缓冲区：一次上游响应最多允许多少字节进内存。流式不聚合，不受它约束。
AIROUTER_STREAM_OUTBOUND_BUFFER_BYTES=1048576
