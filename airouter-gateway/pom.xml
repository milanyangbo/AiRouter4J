<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.airouter</groupId>
    <artifactId>airouter</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>airouter-gateway</artifactId>

  <name>AiRouter :: gateway</name>
  <description>入站 Face、出站 Provider、transport、routing、governance（ADR-0003 第 2 节）。</description>

  <dependencies>
    <!-- gateway 只允许依赖 core 与本层的运行时。跨层协同走 core 里的端口，不走具体类。 -->
    <dependency>
      <groupId>io.github.airouter</groupId>
      <artifactId>airouter-core</artifactId>
    </dependency>

    <!-- WebFlux 在打通入站 Face 的那一票（票 05）引入。同一个运行时同时服务两个方向：
         出站用 WebClient，入站用它的 Face 注解。选它的理由是网关两头都是长连接与流式，
         阻塞式 IO 会把一条流的成本压在一个线程上（ADR-0002）。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webflux</artifactId>
    </dependency>

    <!-- Endpoint 的绑定与校验需要 Spring Boot 的属性基础设施与 jakarta validation。
         绑定只要 spring-boot 就够，但这里是 starters 的口径：
         让「这个模块用 Spring Boot」这件事在依赖清单里有唯一一处形式，而不是拼零件。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

</project>
