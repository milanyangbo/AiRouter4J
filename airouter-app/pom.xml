<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.airouter</groupId>
    <artifactId>airouter</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>airouter-app</artifactId>

  <name>AiRouter :: app</name>
  <description>启动与装配。跨模块的结构约束也住在这里：只有它看得到全部四个模块。</description>

  <dependencies>
    <dependency>
      <groupId>io.github.airouter</groupId>
      <artifactId>airouter-gateway</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.airouter</groupId>
      <artifactId>airouter-agent</artifactId>
    </dependency>

    <!-- WebFlux 而不是 Servlet：网关两头的流量都是长连接 + 流式，
         阻塞式 IO 模型在这里会把一条流的成本压在一个线程上（ADR-0002 第 2 节）。
         它同时是后续所有端到端测试的入站接缝 —— 整个项目只允许有这一个。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webflux</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- 厂商自己的客户端。它只在测试里出现，作用是把「标准客户端能否直接解析我们的响应」
         这件事交给第三方判定：自己写断言证明自己合规，等于自己批自己的卷子。 -->
    <dependency>
      <groupId>com.openai</groupId>
      <artifactId>openai-java</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- 覆盖率断言自己分析探针数据用的库。它与注入探针的插件是同一个版本（根 pom 的 jacoco.version）：
         版本不一致会出现「写数据的和读数据的认不出同一份文件」。 -->
    <dependency>
      <groupId>org.jacoco</groupId>
      <artifactId>org.jacoco.core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- 这里刻意**不**声明 test 作用域的 spring-web。
         它已经由 webflux starter 以 compile 作用域传递进来，而在这里再声明一次并标成 test，
         会按「最近声明优先」把整个 spring-web 降到 test —— 于是可执行 jar 里没有它，
         启动期在 WebClient.builder() 上抛 NoClassDefFoundError。
         测试要用的 HTTP 状态码类型（R4 的违规样例）跟着 compile 作用域一起就在测试 classpath 上。 -->
  </dependencies>

  <build>
    <plugins>
      <!-- 覆盖率门禁（docs/agents/testing.md 第二节：行覆盖率 ≥60%）。
           它跑在 verify 阶段而不是 test 阶段，是因为**它要判的数字里包含本模块自己的测试** ——
           本模块的探针数据要等测试 JVM 退出才落盘，在此之前无数据可判。
           app 是 reactor 里最后一个模块，此时四个模块的报告都已生成。
           根 pom 里 jacoco 的 report 因此绑在 test 阶段，好让这一跳读得到它。

           为什么是一条测试而不是 jacoco:check：check 只认当前模块 target/classes 下的类，
           于是 gateway 那份「被这里的端到端测试跑过」的覆盖率会被算成 0%（实测 14.2% 对 84.0%）。
           接缝在 HTTP 入口这个决定把覆盖数据推到了最后一个模块，判据就得跟着走。

           failIfNoTests 是防「类名改了、这一跳静默空跑」—— 与 ADR-0008 第 6 节同类的要求。 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <executions>
          <execution>
            <id>coverage-gate</id>
            <phase>verify</phase>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <includes>
                <include>**/CoverageFloorTest.java</include>
              </includes>
              <failIfNoTests>true</failIfNoTests>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- 打出可执行 jar：目的是让「可执行 jar 能不能起得来」这件事可以用一条命令回答，
           而不是先祈祷 IDE 的 run configuration 和它一致（阶段 2 起 @SpringBootApplication 已存在）。 -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>repackage</id>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
